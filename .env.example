# サイトの絶対URL (canonical / OGP / sitemap)。本番ドメイン切替前は仮URLを設定、本番では未設定でよい
SITE_URL=

# 既存システム (line.iida-eye.net) のAPI。ブラウザから直接 fetch するため PUBLIC_ 接頭辞が必要
# 診療状況: 未設定の場合は「公式LINEでご確認ください」表示にフォールバックする
PUBLIC_STATUS_API_URL=
# 休診カレンダー: 未設定の場合は本番 https://line.iida-eye.net/api/public/calendar/ を使う (開発環境は line-dev.iida-eye.net)
PUBLIC_CALENDAR_API_URL=

# Cloudflare Web Analytics のトークン (任意)
PUBLIC_CF_ANALYTICS_TOKEN=
