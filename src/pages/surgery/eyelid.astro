---
/**
 * まぶたの手術 (/surgery/eyelid)
 * 眼瞼下垂・眼瞼内反症・霰粒腫に対する保険診療の手術。美容目的の手術は行わない。前頭筋吊り上げ術と小児の内反症手術(全身麻酔)は行わない (院長 2026-11-15)。
 * 見た目の変化やビフォーアフターは書かず、機能(見えにくさ・刺激症状)の改善と限界を書く (医療広告ガイドライン)。
 * 事実は docs/content-notes.md に基づく。[要確認] は確定後に差し替える。
 */
import Page from '@/layouts/Page.astro';

const toc = [
  { href: '#symptoms', label: 'こんな症状はありませんか' },
  { href: '#ptosis', label: '眼瞼下垂' },
  { href: '#entropion', label: '眼瞼内反症' },
  { href: '#chalazion', label: '霰粒腫' },
  { href: '#details', label: '手術について' },
  { href: '#faq', label: 'よくあるご質問' },
];

const symptoms = [
  'まぶたが重く、上のほうが見えにくい',
  '額に力を入れて目を開けている、眉が上がっている',
  '夕方になるとまぶたが下がってくる',
  'まつげが目に当たってゴロゴロする、涙や目やにが出る',
  'まぶたにしこりがあり、腫れや痛みを繰り返す',
];

const diseases = [
  {
    id: 'ptosis',
    name: '眼瞼下垂',
    sub: 'PTOSIS',
    what: '上まぶたを持ち上げる筋肉(眼瞼挙筋)の腱膜がゆるんだり外れたりして、まぶたが十分に上がらなくなった状態です。加齢によるものが最も多く、ハードコンタクトレンズの長期使用や、まぶたを強くこする習慣も原因になります。まぶたが瞳にかかると上方の視野が狭くなり、額の筋肉で目を開けようとするため、肩こりや頭痛の原因になることもあります。',
    surgery: 'ゆるんだ腱膜をまぶたの軟骨(瞼板)に縫い付けて短くする「挙筋前転法」を行います。皮膚のたるみが強い場合は、余った皮膚をあわせて切除します。筋肉の働きそのものが弱い先天性の眼瞼下垂などに行う前頭筋吊り上げ術は、当院では行っていません。[要確認: 眉下皮膚切除の実施の有無]',
    limit: '術後1〜2週間は腫れや内出血が目立ちます。左右差が残る、時間とともに再び下がる、開きすぎて目が閉じにくくなる、といったことがあり、再手術が必要になる場合があります。',
    note: '保険で手術の対象になるのは、まぶたが瞳にかかって見えにくいなど、視機能に支障がある場合です。見た目を整える目的の手術は当院では行っていません。',
  },
  {
    id: 'entropion',
    name: '眼瞼内反症',
    sub: 'ENTROPION',
    what: 'まぶたの縁が内側に向き、まつげが眼の表面に当たる状態です。高齢の方では、下まぶたを支える組織がゆるんで内側に倒れ込む「加齢性眼瞼内反」が多く、お子さんでは、まぶたの皮膚や皮下の脂肪に押されてまつげが内向きになる「睫毛内反」がみられます。まつげが角膜をこすり続けると、ゴロゴロ感や涙、充血が続き、角膜に傷がつきます。',
    surgery: '加齢性眼瞼内反に対し、まぶたの縁が外を向くように、ゆるんだ組織を縫い縮める、または余った皮膚を切除してまつげの向きを整える手術を行います。[要確認: 術式の名称]',
    limit: '時間とともに再び内側に向くことがあります。まつげの一部だけが当たる場合は、手術ではなく抜去で対応することもあります。',
    note: 'お子さんの睫毛内反の手術は全身麻酔が必要なため、現在は当院では行っていません。点眼で角膜を守りながら経過を見て、手術が必要と判断した場合は全身麻酔で手術ができる医療機関をご紹介します。',
  },
  {
    id: 'chalazion',
    name: '霰粒腫',
    sub: 'CHALAZION',
    what: 'まぶたの縁にある脂を出す腺(マイボーム腺)が詰まり、脂がたまって固いしこりになったものです。細菌感染による「ものもらい(麦粒腫)」とは異なり、痛みのないしこりとして残ることが多いですが、炎症を起こすと赤く腫れて痛みます。',
    surgery: '炎症があるあいだは点眼や内服で炎症を抑えます。しこりが残って気になる場合や、大きくなって視界やまばたきに影響する場合は、局所麻酔でまぶたの裏側または表側を小さく切開し、内容物を取り除きます。[要確認: 外来処置として随時行うか、手術枠で行うか]',
    limit: '同じ場所や別の場所に再発することがあります。小さなお子さんはじっとしていられないため、処置が難しい場合は自然に吸収されるのを待つか、全身麻酔で処置ができる医療機関をご紹介します。[要確認: 小児の扱い] 高齢の方で同じ場所に繰り返す場合は、別の病気を区別するために取り除いた組織を検査することがあります。',
    note: '',
  },
];

const details = [
  { k: '手術日', v: '[要確認: 水曜日の手術枠か、外来日に行うか。霰粒腫の切開は外来処置か]' },
  { k: '麻酔', v: '局所麻酔です。まぶたに麻酔の注射をするときに痛みがありますが、その後は強い痛みを感じることはほとんどありません。' },
  { k: '手術時間', v: '[要確認: 術式ごとの所要時間]' },
  { k: '入院', v: '日帰りです。当日の運転はできませんので、ご家族の送迎か公共交通機関でお越しください。' },
  { k: '両眼の場合', v: '[要確認: 両眼同日の可否]' },
  { k: '術後の通院', v: '翌日に傷の確認をし、[要確認: 抜糸の時期(1週間前後)]に抜糸します。その後は経過を見ながら通院していただきます。' },
  { k: '術後の生活', v: '腫れや内出血は1〜2週間かけて引いていきます。洗顔・入浴は翌日から可能ですが、傷をこすらないでください。処方した軟膏や点眼薬は指示どおりにお使いください。' },
  { k: '執刀医', v: '[要確認: 執刀医]' },
  { k: '費用', v: '保険診療です。自己負担額は術式と負担割合により異なり、診察時に目安をお伝えします。' },
];

const faq = [
  { q: '見た目を良くするための手術はできますか?', a: '当院では行っていません。まぶたの手術はいずれも保険診療の範囲で、見えにくさや目の刺激症状など、機能の改善を目的とする場合に行います。' },
  { q: '眼瞼下垂の手術をすると、視野は広がりますか?', a: 'まぶたが瞳にかかっていた分の上方の視野は改善が期待できます。一方で、緑内障など目の中の病気による視野の欠けは、まぶたの手術では変わりません。診察で原因を確かめたうえでご説明します。' },
  { q: '手術の跡は残りますか?', a: 'まぶたのしわに沿って切開するため、時間とともに目立ちにくくなりますが、傷跡が完全に消えるわけではありません。' },
  { q: '子どものまつげが目に当たっています。手術が必要ですか?', a: 'お子さんの睫毛内反は、成長とともに顔立ちが変わって自然に改善することが多く、まずは点眼で角膜を守りながら経過を見ます。角膜の傷が強い場合や、成長しても改善しない場合に手術を検討しますが、お子さんの手術は全身麻酔が必要なため当院では行っておらず、対応できる医療機関をご紹介します。' },
  { q: 'ものもらいと霰粒腫はどう違いますか?', a: 'ものもらい(麦粒腫)は細菌感染による急性の炎症で、抗菌薬の点眼や内服で治ります。霰粒腫は脂の詰まりによるしこりで、炎症が落ち着いても固いしこりが残ることがあり、その場合に切開を検討します。' },
];
---

<Page
  title="まぶたの手術"
  description="イイダ眼科医院のまぶたの手術。眼瞼下垂、眼瞼内反症(逆さまつげ)、霰粒腫に対する手術を、保険診療・局所麻酔・日帰りで行います。見えにくさや目の刺激症状の改善を目的とし、美容目的の手術は行っていません。"
  eyebrow="EYELID SURGERY"
  lead="まぶたが下がって見えにくい、まつげが目に当たる、まぶたのしこりが治らない。こうした症状の原因がまぶたにある場合、手術で改善が期待できます。いずれも保険診療で、局所麻酔・日帰りで行います。"
  crumbs={[{ href: '/medical', label: '診療案内' }, { href: '/surgery', label: '手術のご案内' }, { label: 'まぶたの手術' }]}
  toc={toc}
  cta={{ title: 'まぶたのご相談は、まず外来の診察で', text: '手術が必要かどうか、保険の対象になるかは、診察のうえで判断します。受付方法は「受診案内」をご覧ください。' }}
>
  <section id="symptoms">
    <h2 class="heading">こんな症状はありませんか<span class="sub">SYMPTOMS</span></h2>
    <div class="two-col">
      <ul class="rule-list checks">
        {symptoms.map((s) => <li>{s}</li>)}
      </ul>
      <div class="prose-block">
        <p>まぶたは、目を守り、まばたきで涙を行き渡らせる役割をしています。まぶたが下がる、縁が内側に向く、しこりができるといった変化があると、見えにくさや目の表面の傷につながります。</p>
        <p>当院では、眼瞼下垂・眼瞼内反症・霰粒腫に対する手術を、<strong>保険診療の範囲で</strong>行っています。見た目を整えることを目的とした美容手術は行っていません。</p>
      </div>
    </div>
  </section>

  {diseases.map((d) => (
    <section id={d.id}>
      <h2 class="heading">{d.name}<span class="sub">{d.sub}</span></h2>
      <div class="two-col">
        <div class="prose-block">
          <p>{d.what}</p>
        </div>
        <img class="figure" src="/images/placeholder-interior.svg" alt={`${d.name}の図解`} width="640" height="420" loading="lazy" />
      </div>
      <dl class="rule-list defs">
        <div class="def">
          <dt class="title">手術</dt>
          <dd class="small">{d.surgery}</dd>
        </div>
        <div class="def">
          <dt class="title">限界と合併症</dt>
          <dd class="small">{d.limit}</dd>
        </div>
      </dl>
      {d.note && (
        <div class="note">
          <p class="title">{d.id === 'ptosis' ? '保険診療の対象について' : '対象について'}</p>
          <p class="small">{d.note}</p>
        </div>
      )}
    </section>
  ))}

  <section id="details">
    <h2 class="heading">手術について<span class="sub">DETAILS</span></h2>
    <dl class="rule-list defs">
      {details.map((d) => (
        <div class="def">
          <dt class="title">{d.k}</dt>
          <dd class="small">{d.v}</dd>
        </div>
      ))}
    </dl>
    <p class="small"><a href="/surgery">手術のご案内</a>に、手術までの流れと当日のご案内(来院時間・付き添い・服装)をまとめています。</p>
  </section>

  <section id="faq">
    <h2 class="heading">よくあるご質問<span class="sub">FAQ</span></h2>
    <dl class="rule-list">
      {faq.map((f) => (
        <div class="faq">
          <dt class="title">{f.q}</dt>
          <dd class="small">{f.a}</dd>
        </div>
      ))}
    </dl>
    <div class="related">
      <a class="card" href="/surgery">手術のご案内(流れ・当日)<span>→</span></a>
      <a class="card" href="/surgery/lacrimal">涙道手術(なみだ目)<span>→</span></a>
      <a class="card" href="/visit">受診案内<span>→</span></a>
    </div>
  </section>
</Page>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    scroll-margin-top: 80px;
  }
  .small {
    font-size: 14px;
    line-height: 1.9;
  }
  dd {
    margin: 0;
  }
  .two-col {
    display: grid;
    gap: var(--space-5);
  }
  .prose-block {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .checks li {
    position: relative;
    padding-left: 28px;
    font-weight: 500;
  }
  .checks li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 14px;
    width: 12px;
    height: 12px;
    border: var(--border-hair) solid var(--navy-700);
    border-radius: 3px;
  }
  .def,
  .faq {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .figure {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-md);
    background: var(--surface-100);
  }
  .note {
    padding: 18px 20px;
    border: var(--border-hair) solid var(--line-200);
    border-left: var(--border-accent) solid var(--brand-green);
    border-radius: var(--radius-sm);
    background: var(--surface-card);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .related {
    display: grid;
    gap: 10px;
    margin-top: 8px;
  }
  .related .card {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    font-weight: 500;
    color: var(--ink-900);
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .two-col {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
    .def {
      display: grid;
      grid-template-columns: 160px 1fr;
      gap: 16px;
    }
    .related {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
