---
import { render } from 'astro:content';
import Page from '@/layouts/Page.astro';
import { getNews } from '@/lib/content';
import { formatDate } from '@/lib/site';

export async function getStaticPaths() {
  const items = await getNews({ includeExpired: true });
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const expired = entry.data.expires && entry.data.expires < new Date();
---

<Page
  title={entry.data.title}
  description={entry.data.summary ?? `${entry.data.title} — イイダ眼科医院からのお知らせ`}
  eyebrow={entry.data.category}
  crumbs={[{ href: '/news', label: 'お知らせ' }, { label: entry.data.title }]}
  cta={false}
>
  <article class="article">
    <p class="caption"><time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time></p>
    {expired && <p class="notice">このお知らせの掲載期間は終了しています。最新の情報は<a href="/news">お知らせ一覧</a>をご確認ください。</p>}
    <div class="prose"><Content /></div>
    <p><a class="btn" href="/news">お知らせ一覧へ戻る</a></p>
  </article>
</Page>

<style>
  .article {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 760px;
  }
  .notice {
    padding: 12px 16px;
    background: var(--surface-100);
    border-radius: var(--radius-sm);
    font-size: 13.5px;
  }
  .notice a {
    color: var(--navy-700);
    text-decoration: underline;
  }
</style>
