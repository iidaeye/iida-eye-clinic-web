---
/**
 * こどもの近視進行抑制治療 (/medical/myopia-control)
 * デザインキャンバス「下層ページ」の Myopia を移植。対象は保護者。
 * 選定療養の制度と費用の説明に徹し、効果だけでなく限界・副作用も書く (医療広告ガイドライン)。
 * [要確認] は確定後に差し替える (添付文書の数値、眼鏡処方の算定、オルソケラトロジー等の方針)。
 */
import Page from '@/layouts/Page.astro';

const toc = [
  { href: '#why', label: '近視の進行を抑える意味' },
  { href: '#about', label: 'リジュセア®ミニとは' },
  { href: '#effect', label: '効果と副作用' },
  { href: '#flow', label: '当院での治療の流れ' },
  { href: '#cost', label: '費用(選定療養)' },
  { href: '#faq', label: 'よくあるご質問' },
];

const usage = [
  { k: '使い方', v: '1日1回、寝る前に1滴', note: '忘れた日は追加せず、翌日の就寝前に通常どおり点眼します。' },
  { k: '対象の目安', v: '5〜15歳', note: '国内の臨床試験はこの年齢で行われました。開始は診察で近視の程度と進み方を確認して判断します。' },
  { k: '併用', v: '眼鏡は普段どおり', note: '矯正は眼鏡で続けます。ソフトコンタクトレンズは外してから点眼してください。' },
];

const flow = [
  { n: '01', title: '初回の診察・検査', text: '視力・屈折・眼軸長を測り、近視の程度と進み方を確認します。治療の内容と費用をご説明し、ご希望があれば開始します。' },
  { n: '02', title: '処方と点眼開始', text: '点眼薬を1箱(30日分)ずつお渡しします。毎晩、寝る前に1滴点眼します。' },
  { n: '03', title: '1か月後の確認', text: '点眼が続けられているか、まぶしさなどの症状がないかを確認します。' },
  { n: '04', title: '3か月ごとの定期検査', text: '視力検査と眼軸長測定で進み方を確認し、点眼薬を処方します。度数が変わって眼鏡が合わなくなったときは、眼鏡の処方も行います。' },
];

const costs = [
  { item: 'リジュセア®ミニ点眼液0.025%', sub: '1箱(30日分)', kind: '選定療養', pay: '4,500円 / 箱(全額自己負担)', accent: true },
  { item: '初回の診察・検査', sub: '視力・屈折・眼軸長測定など', kind: '保険診療', pay: '負担割合に応じた自己負担。お住まいの自治体のこども医療費助成の対象になる場合があります。', accent: false },
  { item: '3か月ごとの定期検査', sub: '視力検査・眼軸長測定', kind: '保険診療', pay: '再診料のみのご負担です。検査料は当院では算定しません。', accent: false },
  { item: '治療中の眼鏡処方', sub: '度数が変わったとき', kind: '保険診療', pay: '再診料のみのご負担です。[要確認: 眼鏡処方の算定]', accent: false },
];

const faq = [
  { q: 'いつまで続けるのですか?', a: '全員に共通する終了の年齢はありません。成長に伴う近視の進行は18〜20歳頃にほぼ止まるとされており、定期検査で進み方が落ち着いたことを確認しながら、やめる時期を相談します。' },
  { q: '点眼を始めると近視は治りますか?', a: '治りません。すでにある近視を戻す薬ではなく、これから進む速度を抑える薬です。眼鏡やコンタクトレンズによる矯正はこれまでどおり必要です。' },
  { q: '点眼を忘れた日はどうすればよいですか?', a: 'その日は追加せず、翌日の就寝前に通常どおり1滴点眼してください。回数や滴数を増やさないでください。' },
  { q: '他の近視進行抑制の方法と併用できますか?', a: 'お子さまの状態によります。診察時にご相談ください。[要確認: 当院の方針(オルソケラトロジー等の取り扱い)]' },
];
---

<Page
  title="こどもの近視進行抑制治療"
  description="イイダ眼科医院のこどもの近視進行抑制治療。国内承認の低濃度アトロピン点眼薬リジュセア®ミニ点眼液0.025%を選定療養で処方。効果と副作用、治療の流れ、費用(点眼薬4,500円/箱、診察・検査は保険)。"
  eyebrow="MYOPIA CONTROL"
  lead="国内で承認された低濃度アトロピン点眼薬「リジュセア®ミニ点眼液0.025%」を用いて、お子さまの近視の進行をゆるやかにする治療です。2026年6月から、診察と検査に健康保険が使える「選定療養」として行っています。"
  crumbs={[{ href: '/medical', label: '診療案内' }, { label: 'こどもの近視進行抑制治療' }]}
  heroImage={{ src: '/images/placeholder-interior.svg', alt: '検査を受ける子ども' }}
  toc={toc}
  cta={{ title: 'お子さまの近視が気になったら、ご相談ください', text: '治療を始めるかどうかは、検査で近視の程度と進み方を確認してから一緒に決めます。まずは通常の外来を受診してください。' }}
>
  <section id="why">
    <h2 class="heading">近視の進行を抑える意味<span class="sub">WHY</span></h2>
    <div class="two-col">
      <div class="prose-block">
        <p>こどもの近視の多くは、眼球が前後に伸びる(眼軸長が長くなる)ことで進みます。一度伸びた眼軸は元には戻りません。成長期に近視が強くなるほど、大人になってから網膜や視神経の病気にかかるリスクが高くなることが知られています。</p>
        <p>近視そのものは眼鏡やコンタクトレンズで矯正できますが、「進み方をゆるやかにする」ことが、将来の目の健康を守ることにつながります。近視進行抑制治療は、見え方を良くする治療ではなく、進行の速度を抑える治療です。</p>
      </div>
      <img class="figure" src="/images/placeholder-interior.svg" alt="眼軸長が伸びる図解" width="640" height="420" loading="lazy" />
    </div>
  </section>

  <section id="about">
    <h2 class="heading">リジュセア®ミニ点眼液0.025%とは<span class="sub">ABOUT</span></h2>
    <p>参天製薬の低濃度アトロピン点眼薬で、国内で「近視の進行抑制」を効能・効果として承認された点眼薬です。1回使い切りの容器に入っており、防腐剤を含みません。</p>
    <div class="cards-3">
      {usage.map((u) => (
        <div class="card card--accent usage">
          <p class="eyebrow">{u.k}</p>
          <p class="usage__v">{u.v}</p>
          <p class="small muted">{u.note}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="effect">
    <h2 class="heading">効果と副作用<span class="sub">EFFECT</span></h2>
    <div class="two-col">
      <div class="prose-block">
        <h3 class="heading-sm">期待できる効果</h3>
        <p class="small">国内の5〜15歳を対象とした2年間の臨床試験では、薬を使わない場合に比べて、近視度数の進行を約0.6D、眼軸長の伸びを約0.23mm抑えました。[要確認: 添付文書の数値]</p>
        <p class="small">効果には個人差があります。また、途中でやめると進行が再び速くなる傾向が報告されており、自己判断で中断せず、やめる時期は診察でご相談ください。</p>
      </div>
      <div class="prose-block">
        <h3 class="heading-sm">主な副作用</h3>
        <p class="small">日中のまぶしさ、見え方のかすみ、近くが見えにくい、目の充血などがあります。多くは軽度ですが、症状がある間は自転車や高い遊具など転倒・転落の危険がある遊びは控えてください。</p>
        <p class="small">まぶたの湿疹、強い目の痛み、急な見えにくさがあれば、次の予約を待たずにご連絡ください。緑内障や眼圧上昇の素因がある場合は使用できないことがあります。</p>
      </div>
    </div>
  </section>

  <section id="flow">
    <h2 class="heading">当院での治療の流れ<span class="sub">FLOW</span></h2>
    <ol class="steps">
      {flow.map((s) => (
        <li class="step">
          <span class="step__n">{s.n}</span>
          <p class="title">{s.title}</p>
          <p class="small">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="cost">
    <h2 class="heading">費用(選定療養)<span class="sub">COST</span></h2>
    <p>近視進行抑制を目的とした治療は、2026年6月から厚生労働省の定める選定療養の対象になりました。選定療養とは、患者さんご自身が選択して受ける追加的な医療サービスで、その分の費用は全額自己負担となります。この治療では、点眼薬の費用のみが自己負担で、診察と検査は健康保険の対象です。</p>
    <div class="table-wrap">
      <table class="cost-table">
        <thead>
          <tr><th scope="col">項目</th><th scope="col">区分</th><th scope="col">ご負担</th></tr>
        </thead>
        <tbody>
          {costs.map((c) => (
            <tr class:list={{ 'row--accent': c.accent }}>
              <th scope="row"><span class="item">{c.item}</span><span class="item-sub">{c.sub}</span></th>
              <td class="kind">{c.kind}</td>
              <td>{c.pay}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="caption">点眼薬の費用はこども医療費助成や健康保険の対象になりません。金額は改定されることがあります。最新の金額は院内掲示および診察時の説明文書をご確認ください。</p>
  </section>

  <section id="faq">
    <h2 class="heading">よくあるご質問<span class="sub">FAQ</span></h2>
    <dl class="rule-list">
      {faq.map((f) => (
        <div class="faq">
          <dt class="title">{f.q}</dt>
          <dd class="small">{f.a}</dd>
        </div>
      ))}
    </dl>
    <div class="related">
      <a class="card" href="/visit#notes">眼鏡・コンタクトレンズの処方について<span>→</span></a>
      <a class="card" href="/visit">受診の流れ・受付方法<span>→</span></a>
    </div>
  </section>
</Page>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    scroll-margin-top: 80px;
  }
  .small {
    font-size: 14px;
    line-height: 1.9;
  }
  dd {
    margin: 0;
  }
  .two-col {
    display: grid;
    gap: var(--space-5);
  }
  .prose-block {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .prose-block .heading-sm {
    margin-bottom: -4px;
  }
  .figure {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-md);
    background: var(--surface-100);
  }
  .cards-3 {
    display: grid;
    gap: 12px;
  }
  .usage {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .usage__v {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 600;
    color: var(--navy-700);
    line-height: 1.3;
  }
  .faq {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* 流れ */
  .steps {
    display: grid;
    border-top: var(--border-rule) solid var(--line-strong);
    border-bottom: var(--border-hair) solid var(--line-100);
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 0;
    border-bottom: var(--border-hair) solid var(--line-100);
  }
  .step:last-child {
    border-bottom: 0;
  }
  .step__n {
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 600;
    line-height: 1;
    color: var(--navy-700);
  }

  /* 費用表 */
  .table-wrap {
    overflow-x: auto;
  }
  .cost-table {
    width: 100%;
    min-width: 600px;
    border-collapse: collapse;
    background: var(--surface-card);
    border: var(--border-hair) solid var(--line-200);
    font-size: 13.5px;
    line-height: 1.7;
    text-align: left;
  }
  .cost-table th,
  .cost-table td {
    padding: 12px;
    border-bottom: var(--border-hair) solid var(--line-050);
    vertical-align: top;
  }
  .cost-table thead th {
    background: var(--surface-100);
    font-weight: 700;
    border-bottom: var(--border-rule) solid var(--line-strong);
    white-space: nowrap;
  }
  .cost-table tbody th {
    width: 240px;
    font-weight: 700;
  }
  .item {
    display: block;
  }
  .item-sub {
    display: block;
    font-size: 12px;
    font-weight: 400;
    color: var(--ink-500);
    margin-top: 2px;
  }
  .kind {
    width: 100px;
    white-space: nowrap;
    font-weight: 500;
    color: var(--navy-700);
  }
  .row--accent td,
  .row--accent th {
    background: var(--surface-000);
  }
  .row--accent td:last-child {
    font-weight: 700;
    color: var(--ink-900);
  }
  .related {
    display: grid;
    gap: 10px;
    margin-top: 8px;
  }
  .related .card {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    font-weight: 500;
    color: var(--ink-900);
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .two-col {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
    .cards-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .step {
      padding: 24px 20px;
      border-bottom: 0;
      border-right: var(--border-hair) solid var(--line-100);
    }
    .step:first-child {
      padding-left: 0;
    }
    .step:last-child {
      padding-right: 0;
      border-right: 0;
    }
    .related {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
