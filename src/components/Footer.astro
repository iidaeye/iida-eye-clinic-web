---
/**
 * フッター。左: ロゴ・住所・駐車場・電話・診療時間表・ボタン。右: クレジットカード・サイトマップ・単独リンク。
 * 「診療時間」タブ (Header) の飛び先 #hours はここ。
 */
import Icon from '@/components/Icon.astro';
import Hours from '@/components/Hours.astro';
import { clinic, siteMap, footerLinks, footerLegal, navEn, type Locale } from '@/lib/site';

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;
const ja = locale === 'ja';
---

<footer class="footer" id="hours">
  <div class="container footer__inner">
    <div class="footer__left">
      <a class="footer__logo" href={ja ? '/' : '/en'} aria-label={`${clinic.name} ${clinic.nameEn}`}>
        <img src="/logo/mark.svg" alt="" aria-hidden="true" width="51" height="40" />
        <img src="/logo/wordmark.svg" alt={`${clinic.name} ${clinic.nameEn}`} width="144" height="40" />
      </a>

      <dl class="footer__facts">
        <div class="footer__fact footer__fact--address">
          <dt class="visually-hidden">{ja ? '住所' : 'Address'}</dt>
          <dd>
            {ja ? (
              <>〒{clinic.address.postal}<br />{clinic.address.full}</>
            ) : (
              clinic.address.en
            )}
          </dd>
          <a class="btn btn--white btn--sm" href={clinic.access.mapLink} target="_blank" rel="noopener">
            <Icon name="pin" size={18} />
            {ja ? 'Googleマップで見る' : 'Open in Google Maps'}
          </a>
        </div>
        <div class="footer__fact footer__fact--ink">
          <dt><Icon name="car" size={26} /><span class="visually-hidden">{ja ? '駐車場' : 'Parking'}</span></dt>
          <dd>{ja ? clinic.parking : 'Free parking for 40 cars'}</dd>
        </div>
        <div class="footer__fact">
          <dt><Icon name="phone" size={20} /><span class="visually-hidden">TEL</span></dt>
          <dd><a class="footer__tel" href={clinic.telHref}>{clinic.tel}</a></dd>
        </div>
      </dl>

      <Hours locale={locale} />

      <div class="footer__actions">
        <a class="btn btn--line btn--block" href={clinic.links.line} target="_blank" rel="noopener">
          <Icon name="line" size={26} />
          {ja ? 'LINEで順番をとる' : 'Check in via LINE'}
        </a>
        <a class="btn btn--brown btn--block" href={clinic.telHref}>
          <Icon name="phone" size={20} />
          {ja ? '電話をかける' : 'Call us'}
        </a>
      </div>
    </div>

    <div class="footer__right">
      <div class="cards">
        <p class="cards__title">{ja ? '各種クレジットカードをご利用いただけます' : 'Major credit cards accepted'}</p>
        <ul class="cards__list">
          {clinic.visit.cards.map((c) => (
            <li>{c}</li>
          ))}
        </ul>
      </div>

      {ja ? (
        <nav class="sitemap" aria-label="サイトマップ">
          {siteMap.map((g) => (
            <div class="sitemap__group">
              <a class="sitemap__head" href={g.href}>{g.label}</a>
              <ul class="sitemap__items">
                {g.items.map((i) => (
                  <li><a href={i.href}>{i.label}</a></li>
                ))}
              </ul>
            </div>
          ))}
          <ul class="sitemap__single">
            {footerLinks.map((i) => (
              <li><a href={i.href}>{i.label}</a></li>
            ))}
          </ul>
          <ul class="sitemap__legal">
            {footerLegal.map((i) => (
              <li><a href={i.href}>{i.label}</a></li>
            ))}
          </ul>
        </nav>
      ) : (
        <nav class="sitemap" aria-label="Site map">
          <ul class="sitemap__single">
            {navEn.map((i) => (
              <li><a href={i.href}>{i.label}</a></li>
            ))}
            <li><a href="/">日本語</a></li>
          </ul>
        </nav>
      )}
    </div>
  </div>
  <div class="container footer__bottom">
    <p class="copyright">© Iida eye clinic. since {clinic.founded}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-8);
    padding: var(--space-7) 0 var(--space-5);
    background: var(--surface-000);
    scroll-margin-top: 24px;
  }
  .footer__inner {
    display: grid;
    gap: var(--space-7);
  }
  .footer__left {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .footer__logo {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 8px;
  }
  .footer__logo img:first-child {
    width: 64px;
    height: 50px;
  }
  .footer__logo img:last-child {
    width: 180px;
    height: 50px;
  }
  .footer__facts {
    margin: 0;
  }
  .footer__fact {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 0;
    border-bottom: var(--border-hair) solid var(--line-100);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.7;
    color: var(--ink-900);
  }
  .footer__fact dt {
    display: flex;
    color: var(--brand-blue);
  }
  .footer__fact--ink dt {
    color: var(--ink-900);
  }
  .footer__fact dd {
    margin: 0;
  }
  .footer__fact--address {
    flex-wrap: wrap;
    justify-content: space-between;
    padding-top: 0;
  }
  .footer__fact--address .btn {
    flex-shrink: 0;
    font-weight: 500;
    letter-spacing: 0.1em;
  }
  .footer__tel {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }
  .footer__actions {
    display: grid;
    gap: 12px;
  }
  .footer__actions .btn {
    padding-inline: 16px;
    font-size: 14px;
    white-space: nowrap;
  }

  .footer__right {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .cards {
    background: var(--surface-white);
    border: var(--border-hair) solid var(--line-050);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .cards__title {
    padding: 8px 20px;
    border-bottom: var(--border-hair) solid var(--line-050);
    text-align: center;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--ink-700);
  }
  .cards__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 12px;
    padding: 18px 20px;
  }
  .cards__list li {
    padding: 3px 12px;
    border: var(--border-hair) solid var(--line-100);
    border-radius: 4px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ink-700);
  }

  .sitemap {
    display: flex;
    flex-direction: column;
    gap: 28px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.6;
  }
  .sitemap__group {
    display: grid;
    gap: 8px;
  }
  .sitemap__head {
    font-size: 17px;
    font-weight: 700;
    color: var(--ink-900);
  }
  .sitemap__items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 16px;
  }
  .sitemap__items a,
  .sitemap__single a,
  .sitemap__legal a {
    color: var(--ink-900);
  }
  .sitemap__items a::before {
    content: '';
    display: inline-block;
    width: 12px;
    height: 2px;
    margin-right: 10px;
    vertical-align: middle;
    background: var(--accent-400);
  }
  .sitemap__single,
  .sitemap__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 40px;
  }
  .sitemap__single {
    margin-top: 8px;
    font-size: 17px;
    font-weight: 700;
  }
  .sitemap__legal {
    gap: 8px 0;
    font-size: 15px;
  }
  .sitemap__legal li + li::before {
    content: '／';
    margin-inline: 22px;
    color: var(--ink-700);
  }
  .footer__bottom {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
  }
  .footer__bottom .copyright {
    border-top: var(--border-hair) solid var(--line-050);
    padding-top: var(--space-4);
    text-align: right;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    color: var(--ink-500);
  }

  @media (min-width: 768px) {
    .footer__actions {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
    .sitemap {
      gap: 44px;
    }
    .sitemap__group {
      grid-template-columns: 137px 1fr;
      gap: 0 28px;
    }
    .sitemap__items {
      grid-template-columns: 186px auto;
      gap: 10px 0;
      padding-left: 28px;
      border-left: var(--border-hair) solid var(--line-100);
      white-space: nowrap;
    }
    .sitemap__single {
      gap: 8px 40px;
      font-size: 16px;
    }
  }
  @media (min-width: 1024px) {
    .footer {
      padding-top: var(--space-8);
    }
    .footer__inner {
      grid-template-columns: minmax(0, 500fr) minmax(0, 585fr);
      gap: 92px;
    }
    .footer__right {
      padding-top: 92px;
    }
  }
</style>
