---
/** モバイルのみ画面下部に固定する CTA (電話 / LINE) */
import Icon from '@/components/Icon.astro';
import { clinic, type Locale } from '@/lib/site';

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;
---

<div class="mobile-bar">
  <a class="btn btn--brown" href={clinic.telHref}>
    <Icon name="phone" size={18} />
    {locale === 'ja' ? '電話' : 'Call'}
  </a>
  <a class="btn btn--line" href={clinic.links.line} target="_blank" rel="noopener">
    <Icon name="line" size={22} />
    {locale === 'ja' ? 'LINEで順番をとる' : 'Check in via LINE'}
  </a>
</div>

<style>
  .mobile-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 50;
    display: flex;
    gap: 8px;
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
    background: var(--surface-000);
    border-top: var(--border-hair) solid var(--line-100);
  }
  .mobile-bar .btn {
    min-height: 50px;
    padding-inline: 16px;
  }
  .mobile-bar .btn:first-child {
    flex: 1;
  }
  .mobile-bar .btn--line {
    flex: 2;
  }
  @media (min-width: 768px) {
    .mobile-bar {
      display: none;
    }
  }
</style>
