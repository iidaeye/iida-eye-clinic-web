---
/** モバイルのみ画面下部に固定する CTA (電話 / LINE) */
import { clinic, type Locale } from '@/lib/site';

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;
---

<div class="mobile-bar">
  <a class="btn" href={clinic.telHref}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.8 2z" /></svg>
    {locale === 'ja' ? '電話' : 'Call'}
  </a>
  <a class="btn btn--line" href={clinic.links.line} target="_blank" rel="noopener">
    {locale === 'ja' ? 'LINEで順番をとる' : 'Check in via LINE'}
  </a>
</div>

<style>
  .mobile-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 50;
    display: flex;
    gap: 8px;
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
    background: var(--surface-000);
    border-top: var(--border-hair) solid var(--line-200);
  }
  .mobile-bar .btn {
    min-height: 50px;
  }
  .mobile-bar .btn:first-child {
    flex: 1;
  }
  .mobile-bar .btn--line {
    flex: 2;
  }
  @media (min-width: 768px) {
    .mobile-bar {
      display: none;
    }
  }
</style>
