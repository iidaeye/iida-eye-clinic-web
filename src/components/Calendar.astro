---
/**
 * 休診カレンダー。定休ルール (clinic.json) で基本の表示を即座に組み、
 * LIFF の公開カレンダー API (docs/status-api.md) から月ごとの診療予定を取得して上書きする。
 * 表示規則は LINE 受付の「休診」判定と同じになる。
 * API: GET {PUBLIC_CALENDAR_API_URL}?from=YYYY-MM-DD&to=YYYY-MM-DD
 *   days[]: { date, weekday, is_clinic_day, is_exception, exception_type, exception_reason, am.available, pm.available }
 * 未設定時は本番 URL を使う。取得失敗・complete=false のときは定休ルールだけで描き、注意文を出す。
 */
import { clinic, type Locale } from '@/lib/site';

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;
const api = import.meta.env.PUBLIC_CALENDAR_API_URL || 'https://line.iida-eye.net/api/public/calendar/';
const rules = JSON.stringify({ am: clinic.hours.am, pm: clinic.hours.pm });
---

<div class="calendar" data-calendar-api={api} data-rules={rules} data-locale={locale}>
  <div class="calendar__head">
    <p class="title">{locale === 'ja' ? '休診カレンダー' : 'Closed days'}</p>
    <div class="calendar__nav">
      <button type="button" data-cal-prev aria-label={locale === 'ja' ? '前の月' : 'Previous month'}>‹</button>
      <span data-cal-title class="calendar__month"></span>
      <button type="button" data-cal-next aria-label={locale === 'ja' ? '次の月' : 'Next month'}>›</button>
    </div>
  </div>
  <div class="calendar__grid" data-cal-grid role="grid"></div>
  <ul class="calendar__legend">
    <li><span class="dot dot--closed"></span>{locale === 'ja' ? '休診' : 'Closed'}</li>
    <li><span class="dot dot--pm"></span>{locale === 'ja' ? '午後休診' : 'PM closed'}</li>
    <li><span class="dot dot--am"></span>{locale === 'ja' ? '午前休診' : 'AM closed'}</li>
    <li><span class="dot dot--note"></span>{locale === 'ja' ? '臨時診療' : 'Special hours'}</li>
  </ul>
  <ul class="calendar__exceptions" data-cal-exceptions hidden></ul>
  <p class="calendar__warn" data-cal-warn hidden>
    {locale === 'ja'
      ? '最新の休診情報を取得できませんでした。通常の診療日程を表示しています。臨時休診は公式LINEまたはお電話でご確認ください。'
      : 'Latest closure information could not be loaded. Regular hours are shown. Please check our LINE account or call us for temporary closures.'}
  </p>
  <noscript><p class="calendar__warn">{locale === 'ja' ? '休診日は公式LINE、またはお電話でご確認ください。' : 'Please check our LINE account or call us for closed days.'}</p></noscript>
</div>

<script>
  type Kind = 'closed' | 'pm-closed' | 'am-closed' | 'note';
  type Session = { available: boolean };
  type ApiDay = {
    date: string;
    weekday: string;
    is_clinic_day: boolean;
    is_exception: boolean;
    exception_type: 'holiday' | 'closed' | 'special' | null;
    exception_reason: string | null;
    am: Session;
    pm: Session;
  };
  type ApiCalendar = { from: string; to: string; complete: boolean; days: ApiDay[] };
  type DayInfo = { kind: Kind | null; reason: string | null; type: ApiDay['exception_type'] };
  type MonthData = { days: Record<string, DayInfo>; complete: boolean };

  const root = document.querySelector<HTMLElement>('[data-calendar-api]');
  if (root) {
    const ja = root.dataset.locale !== 'en';
    const api = root.dataset.calendarApi ?? '';
    const rules = JSON.parse(root.dataset.rules!) as { am: string[]; pm: string[] };
    const grid = root.querySelector<HTMLElement>('[data-cal-grid]')!;
    const title = root.querySelector<HTMLElement>('[data-cal-title]')!;
    const list = root.querySelector<HTMLElement>('[data-cal-exceptions]')!;
    const warn = root.querySelector<HTMLElement>('[data-cal-warn]')!;
    const months = new Map<string, MonthData | 'error'>();
    const today = new Date();
    let y = today.getFullYear();
    let m = today.getMonth();

    const dayNames = ja ? ['日', '月', '火', '水', '木', '金', '土'] : ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
    const ruleIndex = (dow: number) => (dow + 6) % 7; // JS: 0=日 → clinic.json: 0=月
    const pad = (n: number) => String(n).padStart(2, '0');
    const key = (yy: number, mm: number, d: number) => `${yy}-${pad(mm + 1)}-${pad(d)}`;
    const monthKey = (yy: number, mm: number) => `${yy}-${pad(mm + 1)}`;

    function baseKind(date: Date): Kind | null {
      const i = ruleIndex(date.getDay());
      const am = rules.am[i];
      const pm = rules.pm[i];
      if (am !== 'open' && pm !== 'open') return 'closed';
      if (am === 'open' && pm !== 'open') return 'pm-closed';
      if (am !== 'open' && pm === 'open') return 'am-closed';
      return null;
    }

    function classify(d: ApiDay): Kind | null {
      if (d.exception_type === 'special') return 'note';
      if (!d.is_clinic_day) return 'closed';
      if (d.am.available && !d.pm.available) return 'pm-closed';
      if (!d.am.available && d.pm.available) return 'am-closed';
      return null;
    }

    function kindLabel(kind: Kind | null): string {
      if (kind === 'closed') return ja ? '休診' : 'Closed';
      if (kind === 'pm-closed') return ja ? '午後休診' : 'PM closed';
      if (kind === 'am-closed') return ja ? '午前休診' : 'AM closed';
      if (kind === 'note') return ja ? '臨時診療' : 'Special hours';
      return '';
    }

    async function load(yy: number, mm: number): Promise<MonthData | 'error'> {
      const k = monthKey(yy, mm);
      const cached = months.get(k);
      if (cached) return cached;
      if (!api) return 'error';
      try {
        const from = key(yy, mm, 1);
        const to = key(yy, mm, new Date(yy, mm + 1, 0).getDate());
        const sep = api.includes('?') ? '&' : '?';
        const res = await fetch(`${api}${sep}from=${from}&to=${to}`);
        if (!res.ok) throw new Error(String(res.status));
        const data = (await res.json()) as ApiCalendar;
        const days: Record<string, DayInfo> = {};
        for (const d of data.days ?? []) {
          days[d.date] = { kind: classify(d), reason: d.exception_reason, type: d.exception_type };
        }
        const result: MonthData = { days, complete: data.complete !== false };
        months.set(k, result);
        return result;
      } catch {
        months.set(k, 'error');
        return 'error';
      }
    }

    function render(data: MonthData | 'error' | null) {
      title.textContent = ja ? `${y}年${m + 1}月` : new Date(y, m, 1).toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
      const first = new Date(y, m, 1);
      const last = new Date(y, m + 1, 0);
      const api = data && data !== 'error' ? data : null;
      const cells: string[] = dayNames.map((d, i) => `<div class="calendar__dow${i === 0 ? ' is-sun' : i === 6 ? ' is-sat' : ''}" role="columnheader">${d}</div>`);
      for (let i = 0; i < first.getDay(); i++) cells.push('<div class="calendar__empty"></div>');
      for (let d = 1; d <= last.getDate(); d++) {
        const date = new Date(y, m, d);
        const k = key(y, m, d);
        const info = api?.days[k];
        const kind = info ? info.kind : baseKind(date);
        const isToday = date.toDateString() === today.toDateString();
        const label = kindLabel(kind);
        cells.push(
          `<div class="calendar__day${kind ? ` is-${kind}` : ''}${isToday ? ' is-today' : ''}" role="gridcell"${label ? ` aria-label="${d}${ja ? '日 ' : ' '}${label}"` : ''}><span>${d}</span></div>`,
        );
      }
      grid.innerHTML = cells.join('');

      // 臨時休診・臨時診療の一覧 (祝日と定休は載せない)。理由は FileMaker の自由入力なので textContent で入れる
      list.innerHTML = '';
      const items = api
        ? Object.entries(api.days).filter(([, v]) => v.type === 'closed' || v.type === 'special')
        : [];
      for (const [k, v] of items) {
        const date = new Date(`${k}T00:00:00`);
        const li = document.createElement('li');
        const when = document.createElement('span');
        when.className = 'calendar__ex-date';
        when.textContent = ja
          ? `${date.getMonth() + 1}月${date.getDate()}日(${dayNames[date.getDay()]})`
          : date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', weekday: 'short' });
        const what = document.createElement('span');
        what.className = `calendar__ex-kind${v.kind ? ` is-${v.kind}` : ''}`;
        what.textContent = kindLabel(v.kind);
        li.append(when, what);
        if (v.reason) {
          const why = document.createElement('span');
          why.className = 'calendar__ex-reason';
          why.textContent = v.reason;
          li.append(why);
        }
        list.appendChild(li);
      }
      list.hidden = items.length === 0;
      warn.hidden = !!api && api.complete;
    }

    async function show() {
      const k = monthKey(y, m);
      render(months.get(k) ?? null);
      const data = await load(y, m);
      // 取得中に月を移動していたら、古い月の結果で上書きしない
      if (monthKey(y, m) === k) render(data);
    }

    root.querySelector('[data-cal-prev]')?.addEventListener('click', () => {
      m--;
      if (m < 0) { m = 11; y--; }
      show();
    });
    root.querySelector('[data-cal-next]')?.addEventListener('click', () => {
      m++;
      if (m > 11) { m = 0; y++; }
      show();
    });

    show();
  }
</script>

<style>
  /* グリッドのセルと臨時休診の一覧は JS で生成するため、スコープ付き CSS が当たらない。:global() で指定する */
  .calendar {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .calendar__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .calendar__nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .calendar__nav button {
    width: 36px;
    height: 36px;
    border: var(--border-hair) solid var(--line-200);
    border-radius: var(--radius-sm);
    background: var(--surface-card);
    cursor: pointer;
    font-size: 18px;
    line-height: 1;
  }
  .calendar__month {
    min-width: 7em;
    text-align: center;
    font-weight: 700;
    font-size: 14px;
  }
  /* 格子: セルの右と下に 1px の薄い罫線、外枠は 1px の濃い罫線 */
  .calendar__grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0;
    background: var(--surface-card);
    border: var(--border-hair) solid var(--line-200);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .calendar__grid :global(.calendar__dow),
  .calendar__grid :global(.calendar__day),
  .calendar__grid :global(.calendar__empty) {
    border-right: var(--border-hair) solid var(--line-050);
    border-bottom: var(--border-hair) solid var(--line-050);
  }
  .calendar__grid :global(:nth-child(7n)) {
    border-right: 0;
  }
  .calendar__grid :global(:nth-last-child(-n + 7)) {
    border-bottom: 0;
  }
  .calendar__grid :global(.calendar__dow) {
    padding: 6px 0;
    text-align: center;
    font-size: 11.5px;
    font-weight: 700;
    color: var(--ink-500);
    background: var(--surface-100);
    border-bottom-color: var(--line-200);
  }
  .calendar__grid :global(.calendar__dow.is-sun) {
    color: var(--alert-700);
  }
  .calendar__grid :global(.calendar__dow.is-sat) {
    color: var(--navy-700);
  }
  .calendar__grid :global(.calendar__day) {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    font-size: 14px;
    font-weight: 500;
  }
  /* 塗り分けは旧サイト (休診=ピンク、午後休診=水色、お知らせ=黄) を踏襲。色は design/tokens.json の cal-* */
  .calendar__grid :global(.calendar__day.is-closed) {
    background: var(--cal-closed-bg);
    color: var(--cal-closed-ink);
  }
  /* 半日休診: 左上=午前、右下=午後。斜線で区切り、休診側だけ塗る */
  .calendar__grid :global(.calendar__day.is-pm-closed) {
    background: linear-gradient(
      to bottom right,
      transparent calc(50% - 0.5px),
      var(--line-100) calc(50% - 0.5px),
      var(--line-100) calc(50% + 0.5px),
      var(--cal-pm-bg) calc(50% + 0.5px)
    );
  }
  .calendar__grid :global(.calendar__day.is-am-closed) {
    background: linear-gradient(
      to bottom right,
      var(--cal-am-bg) calc(50% - 0.5px),
      var(--line-100) calc(50% - 0.5px),
      var(--line-100) calc(50% + 0.5px),
      transparent calc(50% + 0.5px)
    );
  }
  .calendar__grid :global(.calendar__day.is-note) {
    background: var(--cal-special-bg);
    color: var(--cal-special-ink);
    box-shadow: inset 0 0 0 2px var(--brand-green);
  }
  .calendar__grid :global(.calendar__day.is-today span) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-pill);
    background: var(--navy-700);
    color: var(--surface-000);
  }
  .calendar__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 12px;
    color: var(--ink-500);
  }
  .calendar__legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 3px;
  }
  .dot--closed {
    background: var(--cal-closed-bg);
    border: 1px solid var(--cal-closed-ink);
  }
  .dot--pm {
    background: linear-gradient(to bottom right, var(--surface-card) 50%, var(--cal-pm-bg) 50%);
    border: 1px solid var(--cal-pm-ink);
  }
  .dot--am {
    background: linear-gradient(to bottom right, var(--cal-am-bg) 50%, var(--surface-card) 50%);
    border: 1px solid var(--cal-am-ink);
  }
  .dot--note {
    background: var(--cal-special-bg);
    box-shadow: inset 0 0 0 2px var(--brand-green);
  }

  /* 臨時休診の一覧 */
  .calendar__exceptions {
    display: flex;
    flex-direction: column;
    border-top: var(--border-hair) solid var(--line-100);
    font-size: 13px;
    line-height: 1.7;
  }
  .calendar__exceptions :global(li) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    padding: 8px 0;
    border-bottom: var(--border-hair) solid var(--line-100);
  }
  .calendar__exceptions :global(.calendar__ex-date) {
    font-weight: 700;
    color: var(--ink-900);
    white-space: nowrap;
  }
  .calendar__exceptions :global(.calendar__ex-kind) {
    padding: 0 8px;
    border-radius: 3px;
    font-weight: 700;
    white-space: nowrap;
    background: var(--cal-closed-bg);
    color: var(--cal-closed-ink);
  }
  .calendar__exceptions :global(.calendar__ex-kind.is-pm-closed) {
    background: var(--cal-pm-bg);
    color: var(--cal-pm-ink);
  }
  .calendar__exceptions :global(.calendar__ex-kind.is-am-closed) {
    background: var(--cal-am-bg);
    color: var(--cal-am-ink);
  }
  .calendar__exceptions :global(.calendar__ex-kind.is-note) {
    background: var(--cal-special-bg);
    color: var(--cal-special-ink);
  }
  .calendar__exceptions :global(.calendar__ex-reason) {
    flex-basis: 100%;
    color: var(--ink-500);
  }
  .calendar__warn {
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--alert-700);
  }
</style>
