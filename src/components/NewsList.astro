---
import { formatDate } from '@/lib/site';
import type { NewsEntry } from '@/lib/content';

interface Props {
  items: NewsEntry[];
  /** 一覧ページでは本文要約も出す */
  withSummary?: boolean;
}
const { items, withSummary = false } = Astro.props;
---

<ul class="rule-list news-list">
  {items.length === 0 && <li class="muted">現在お知らせはありません。</li>}
  {items.map((n) => (
    <li>
      <a href={`/news/${n.id}`} class="news-item">
        <span class="news-item__meta">
          <time datetime={n.data.date.toISOString()}>{formatDate(n.data.date)}</time>
          <span class:list={['news-item__cat', `news-item__cat--${n.data.category}`]}>{n.data.category}</span>
        </span>
        <span class="news-item__title">{n.data.title}</span>
        {withSummary && n.data.summary && <span class="news-item__summary">{n.data.summary}</span>}
      </a>
    </li>
  ))}
</ul>

<style>
  .news-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .news-item__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    color: var(--ink-500);
  }
  .news-item__cat {
    padding: 1px 8px;
    border: var(--border-hair) solid var(--line-200);
    border-radius: 3px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .news-item__cat--重要 {
    border-color: var(--navy-700);
    color: var(--navy-700);
  }
  .news-item__title {
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.6;
    color: var(--ink-900);
  }
  .news-item__summary {
    font-size: 13px;
    line-height: 1.8;
    color: var(--ink-700);
  }
  @media (min-width: 768px) {
    .news-item {
      display: grid;
      grid-template-columns: 180px 1fr;
      column-gap: 20px;
      align-items: baseline;
    }
    .news-item__summary {
      grid-column: 2;
    }
    .news-item__title {
      font-size: 15px;
    }
  }
</style>
