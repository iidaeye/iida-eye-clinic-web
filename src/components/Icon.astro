---
/**
 * 線画アイコン (24x24, currentColor)。装飾用なので aria-hidden。意味を持たせる場合は呼び出し側でラベルを付ける。
 * LINE と Instagram はブランドの形に寄せた簡略版。
 */
interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
export type IconName =
  | 'eye' | 'lens' | 'glasses' | 'drop' | 'doctor' | 'stethoscope'
  | 'check' | 'phone' | 'car' | 'pin' | 'clock' | 'instagram' | 'line' | 'user'
  | 'arrow' | 'chevron-left' | 'chevron-right' | 'sparkle';

const { name, size = 24, class: cls } = Astro.props;

const stroke = 'fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"';
const paths: Record<IconName, string> = {
  eye: `<g ${stroke}><path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12Z"/><circle cx="12" cy="12" r="3.2"/></g><circle cx="13.2" cy="10.8" r="1" fill="currentColor"/>`,
  lens: `<g ${stroke}><path d="M3 12.5a4.5 4.5 0 0 1 9 0v.5a4.5 4.5 0 0 1-9 0Z"/><path d="M12 12.5a4.5 4.5 0 0 1 9 0v.5a4.5 4.5 0 0 1-9 0Z"/><path d="M3.5 10.5h17" /></g><text x="7.5" y="15" font-size="5.5" font-weight="700" text-anchor="middle" fill="currentColor" font-family="sans-serif">L</text><text x="16.5" y="15" font-size="5.5" font-weight="700" text-anchor="middle" fill="currentColor" font-family="sans-serif">R</text>`,
  glasses: `<g ${stroke}><circle cx="6.5" cy="14" r="3.5"/><circle cx="17.5" cy="14" r="3.5"/><path d="M10 13.5c.6-.6 1.4-.9 2-.9s1.4.3 2 .9"/><path d="M3 13.5 5 7h2"/><path d="M21 13.5 19 7h-2"/></g>`,
  drop: `<g ${stroke}><path d="M9 3h6v2.5H9z"/><path d="M10 5.5h4v2.5h-4z"/><path d="M8 8h8l1.5 3v8a2 2 0 0 1-2 2h-7a2 2 0 0 1-2-2v-8Z"/><path d="M8 14h8"/></g><path d="M12 11.2c-.8 1-1.4 1.8-1.4 2.5a1.4 1.4 0 0 0 2.8 0c0-.7-.6-1.5-1.4-2.5Z" fill="currentColor"/>`,
  doctor: `<g ${stroke}><circle cx="12" cy="7.5" r="3.5"/><path d="M4.5 21v-2.5a4 4 0 0 1 4-4h7a4 4 0 0 1 4 4V21"/><path d="M10 14.5 12 18l2-3.5"/><path d="M8.2 6.2c1.2-.8 2.4-1.2 3.8-1.2s2.6.4 3.8 1.2"/></g><circle cx="12" cy="6" r="1" fill="currentColor"/>`,
  stethoscope: `<g ${stroke}><path d="M6 3v6a5 5 0 0 0 10 0V3"/><path d="M11 14v2.5a4.5 4.5 0 0 0 9 0V14"/><circle cx="20" cy="11.5" r="2"/></g>`,
  check: `<g ${stroke}><rect x="3.5" y="3.5" width="17" height="17" rx="3"/><path d="m7.5 12.5 3 3 6.5-7"/></g>`,
  phone: `<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.8 2z" fill="currentColor"/>`,
  car: `<g ${stroke}><path d="M4 16v-4l2-5.5A1.5 1.5 0 0 1 7.4 5.5h9.2a1.5 1.5 0 0 1 1.4 1L20 12v4"/><path d="M4 16h16v2.5H4z"/><path d="M4 12h16"/><circle cx="7.5" cy="14" r=".8" fill="currentColor"/><circle cx="16.5" cy="14" r=".8" fill="currentColor"/></g>`,
  pin: `<g ${stroke}><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/></g>`,
  clock: `<g ${stroke}><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></g>`,
  instagram: `<g ${stroke}><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="3.8"/></g><circle cx="17" cy="7" r="1.1" fill="currentColor"/>`,
  line: `<path d="M12 3C6.5 3 2 6.6 2 11c0 3.9 3.4 7.1 8 7.8.3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c0 .3-.2 1 .9.6 1.1-.5 5.9-3.5 8-6 1.5-1.6 2.3-3.2 2.3-5C22 6.6 17.5 3 12 3Z" fill="currentColor"/><g fill="#fff"><rect x="6.2" y="8.8" width="1.3" height="4.4"/><rect x="6.2" y="12.1" width="2.8" height="1.1"/><rect x="9.8" y="8.8" width="1.3" height="4.4"/><path d="M12.1 8.8h1.2l2 2.7V8.8h1.3v4.4h-1.2l-2-2.7v2.7h-1.3z"/><path d="M17.5 8.8h2.8v1.1h-1.5v.6h1.5v1h-1.5v.6h1.5v1.1h-2.8z"/></g>`,
  user: `<circle cx="12" cy="12" r="10" fill="currentColor"/><g fill="#fff"><circle cx="12" cy="9.5" r="3"/><path d="M6.5 18a5.5 5.5 0 0 1 11 0 9 9 0 0 1-11 0Z"/></g>`,
  arrow: `<path d="M8 5.5v13l10-6.5Z" ${stroke}/>`,
  'chevron-left': `<path d="m14.5 6-6 6 6 6" ${stroke}/>`,
  'chevron-right': `<path d="m9.5 6 6 6-6 6" ${stroke}/>`,
  sparkle: `<g ${stroke} stroke-width="2"><path d="M12 3v5"/><path d="m5 6 3.5 3.5"/><path d="m19 6-3.5 3.5"/></g>`,
};
---

<svg class={cls} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={paths[name]} />
