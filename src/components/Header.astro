---
/**
 * ヘッダー。PC: 白い上段 (ロゴ・電話・Instagram・LINE) + 生成りの地の上に白いナビ帯。右端に固定の「診療時間」タブ。
 * モバイル: ロゴ + LINE + ハンバーガー。
 */
import Icon from '@/components/Icon.astro';
import { clinic, nav, navEn, isCurrent, type Locale } from '@/lib/site';

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;
const items = locale === 'ja' ? nav : navEn;
const path = Astro.url.pathname;
const home = locale === 'ja' ? '/' : '/en';
const lineLabel = locale === 'ja' ? 'LINEで順番をとる' : 'Check in via LINE';
---

<header class="header">
  <div class="container header__bar">
    <a class="logo" href={home} aria-label={`${clinic.name} ${clinic.nameEn}`}>
      <img src="/logo/mark.svg" alt="" aria-hidden="true" width="51" height="40" />
      <img src="/logo/wordmark.svg" alt={`${clinic.name} ${clinic.nameEn}`} width="144" height="40" />
    </a>

    <div class="header__contact">
      <a class="tel" href={clinic.telHref}>
        <Icon name="phone" size={22} class="tel__icon" />
        <span class="tel__num">{clinic.tel}</span>
      </a>
      <p class="tel__note">{locale === 'ja' ? clinic.hours.closedNote : clinic.hours.closedNoteEn}</p>
    </div>

    <a class="insta" href={clinic.links.instagram} target="_blank" rel="noopener">
      <Icon name="instagram" size={26} />
      <span>Instagram</span>
    </a>

    <a class="btn btn--line header__line" href={clinic.links.line} target="_blank" rel="noopener">
      <Icon name="line" size={22} />
      {lineLabel}
    </a>

    <a class="lang" href={locale === 'ja' ? '/en' : '/'} lang={locale === 'ja' ? 'en' : 'ja'}>
      {locale === 'ja' ? 'EN' : '日本語'}
    </a>

    <button class="menu-btn" type="button" aria-label={locale === 'ja' ? 'メニュー' : 'Menu'} aria-expanded="false" aria-controls="mobile-nav">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
  </div>

  <div class="header__navwrap">
    <div class="container">
      <nav class="nav" aria-label={locale === 'ja' ? 'グローバルナビゲーション' : 'Main navigation'}>
        <ul>
          {items.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(path, item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" hidden aria-label={locale === 'ja' ? 'メニュー' : 'Menu'}>
    <ul>
      {items.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
      {locale === 'ja' && (
        <>
          <li><a href="/column">コラム</a></li>
          <li><a href="/disclosure">掲示事項</a></li>
        </>
      )}
    </ul>
    <div class="mobile-nav__actions">
      <a class="btn btn--brown btn--block" href={clinic.telHref}><Icon name="phone" size={18} />{clinic.tel}</a>
      <a class="btn btn--line btn--block" href={clinic.links.line} target="_blank" rel="noopener"><Icon name="line" size={22} />{lineLabel}</a>
      <a class="btn btn--white btn--block" href={clinic.links.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={20} />Instagram</a>
    </div>
  </nav>
</header>

<a class="side-tab" href="#hours">
  <Icon name="clock" size={24} />
  <span>{locale === 'ja' ? '診療時間' : 'Hours'}</span>
</a>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const panel = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });
</script>

<style>
  .header {
    background: var(--surface-white);
  }
  .header__bar {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 64px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    margin-right: auto;
  }
  .logo img:first-child {
    width: 41px;
    height: 32px;
  }
  .logo img:last-child {
    width: 115px;
    height: 32px;
  }

  .header__contact,
  .insta,
  .lang,
  .header__navwrap {
    display: none;
  }
  .header__line {
    min-height: 40px;
    padding: 0 14px;
    font-size: 12.5px;
    gap: 6px;
    white-space: nowrap;
  }
  .menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1.5px solid var(--brand-blue);
    border-radius: var(--radius-md);
    background: var(--surface-white);
    color: var(--brand-blue);
    cursor: pointer;
  }

  .mobile-nav {
    border-top: var(--border-hair) solid var(--line-100);
    background: var(--surface-card);
  }
  .mobile-nav ul {
    padding: var(--space-2) var(--space-4);
  }
  .mobile-nav li a {
    display: block;
    padding: 14px 0;
    font-weight: 700;
    letter-spacing: 0.06em;
    border-bottom: var(--border-hair) solid var(--line-100);
  }
  .mobile-nav__actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: var(--space-4);
  }

  .side-tab {
    display: none;
  }

  @media (min-width: 1024px) {
    .header__bar {
      min-height: 84px;
      gap: 28px;
    }
    .logo img:first-child {
      width: 51px;
      height: 40px;
    }
    .logo img:last-child {
      width: 144px;
      height: 40px;
    }
    .header__contact {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0;
    }
    .tel {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--ink-900);
    }
    .tel__icon {
      color: var(--brand-blue);
    }
    .tel__num {
      font-size: 28px;
      font-weight: 700;
      letter-spacing: 0.04em;
      line-height: 1.2;
      font-variant-numeric: tabular-nums;
    }
    .tel__note {
      font-size: 11px;
      line-height: 1.5;
      letter-spacing: 0.02em;
      color: var(--ink-500);
    }
    .insta {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: var(--ink-900);
    }
    .header__line {
      min-height: 50px;
      padding: 0 24px;
      font-size: 14px;
      gap: 10px;
    }
    .lang {
      display: inline-block;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: var(--ink-500);
    }
    .menu-btn,
    .mobile-nav {
      display: none;
    }

    /* ナビ帯: 生成りの地の上に白い帯 (下の角だけ丸い) */
    .header__navwrap {
      display: block;
      background: var(--surface-000);
    }
    .nav {
      margin-left: auto;
      width: fit-content;
      padding: 0 40px;
      background: var(--surface-white);
      border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    }
    .nav ul {
      display: flex;
      gap: 40px;
    }
    .nav a {
      display: inline-block;
      padding: 16px 0 14px;
      font-size: 14.5px;
      font-weight: 700;
      letter-spacing: 0.06em;
      color: var(--ink-900);
      border-bottom: 2px solid transparent;
    }
    .nav a:hover,
    .nav a[aria-current='page'] {
      color: var(--brand-blue);
      border-bottom-color: var(--brand-blue);
    }

    /* 右端の固定タブ */
    .side-tab {
      position: fixed;
      right: 0;
      top: 170px;
      z-index: 40;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      padding: 26px 20px 30px;
      background: var(--brand-blue);
      color: #fff;
      border-radius: var(--radius-lg) 0 0 var(--radius-lg);
      font-size: 16px;
      font-weight: 700;
    }
    .side-tab span {
      writing-mode: vertical-rl;
      letter-spacing: 0.3em;
    }
    .side-tab:hover {
      color: #fff;
      background: #1b579b;
    }
  }
</style>
