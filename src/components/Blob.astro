---
/** 飾りの有機的なブロブ。装飾のみ (aria-hidden)。位置と大きさは呼び出し側の class で指定する */
interface Props {
  shape?: 1 | 2 | 3;
  color?: 'blue' | 'green' | 'cream' | 'sky';
  class?: string;
}
const { shape = 1, color = 'blue', class: cls } = Astro.props;
const shapes = {
  1: 'M38 92C18 56 44 14 92 10s104 22 100 66-48 74-96 72S58 128 38 92Z',
  2: 'M12 70C8 34 48 8 96 12s100 36 92 72-56 60-104 58S16 106 12 70Z',
  3: 'M30 60c6-30 42-48 80-44s84 30 78 60-44 50-86 48S24 90 30 60Z',
};
const fills = { blue: 'var(--brand-blue)', green: 'var(--brand-green)', cream: 'var(--surface-100)', sky: 'var(--sky-200)' };
---

<svg class:list={['blob', cls]} viewBox="0 0 200 160" aria-hidden="true" focusable="false">
  <path d={shapes[shape]} fill={fills[color]} />
</svg>

<style>
  .blob {
    position: absolute;
    pointer-events: none;
    z-index: 0;
  }
</style>
