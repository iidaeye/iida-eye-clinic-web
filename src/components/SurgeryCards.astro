---
/** 術式のカード (clinic.json の surgeries)。生成りの面の上に置く白いカード (トップの手術ブロック・手術のご案内)。枚数に応じて 1 行に並ぶ */
import { clinic } from '@/lib/site';

interface Props {
  /** true なら各カードに説明文(lead)を出す */
  detailed?: boolean;
}
const { detailed = false } = Astro.props;
---

<ul class:list={['surgery-cards', { 'surgery-cards--detailed': detailed }]}>
  {clinic.surgeries.map((s) => (
    <li>
      <a class="surgery-card" href={`/surgery/${s.slug}`}>
        <span class="surgery-card__name">{s.name}</span>
        <span class="surgery-card__text">{detailed ? s.lead : s.short}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .surgery-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .surgery-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding: 16px 16px 18px;
    background: var(--surface-000);
    border-radius: var(--radius-btn);
  }
  .surgery-card:hover {
    color: inherit;
  }
  .surgery-card:hover .surgery-card__name {
    color: var(--brand-blue);
  }
  .surgery-card__name {
    padding-bottom: 10px;
    border-bottom: var(--border-hair) solid var(--line-050);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink-900);
  }
  .surgery-card__text {
    font-size: 12px;
    line-height: 1.8;
    color: var(--ink-700);
  }
  @media (min-width: 768px) {
    .surgery-cards {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 16px;
    }
    .surgery-cards--detailed {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .surgery-card {
      padding: 22px 22px 24px;
      gap: 14px;
    }
    .surgery-card__name {
      font-size: 17px;
      padding-bottom: 14px;
    }
    .surgery-card__text {
      font-size: 14px;
    }
  }
  @media (min-width: 1024px) {
    .surgery-cards {
      gap: 30px;
    }
  }
</style>
