---
/**
 * 下層ページの型: パンくず → 英字ラベル+明朝タイトル+リード(+ヒーロー画像) → 本文 → 共通CTA。
 * toc を渡すと PC では左に固定目次、本文は右の2カラムになる。
 */
import Base from '@/layouts/Base.astro';
import Cta from '@/components/Cta.astro';
import type { Locale } from '@/lib/site';

interface Crumb {
  href?: string;
  label: string;
}
interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  lead?: string;
  crumbs?: Crumb[];
  toc?: { href: string; label: string }[];
  heroImage?: { src: string; alt: string };
  locale?: Locale;
  cta?: { title: string; text: string } | false;
}

const { title, description, eyebrow, lead, crumbs = [], toc, heroImage, locale = 'ja', cta } = Astro.props;
---

<Base title={title} description={description} locale={locale}>
  <div class="container page-head">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label={locale === 'ja' ? 'パンくず' : 'Breadcrumb'}>
        <ol>
          <li><a href={locale === 'ja' ? '/' : '/en'}>{locale === 'ja' ? 'ホーム' : 'Home'}</a></li>
          {crumbs.map((c) => (
            <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
    <div class:list={['page-title', { 'page-title--with-image': !!heroImage }]}>
      <div class="page-title__text">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
        {lead && <p class="lead">{lead}</p>}
      </div>
      {heroImage && <img class="page-title__image" src={heroImage.src} alt={heroImage.alt} loading="eager" />}
    </div>
  </div>

  <div class:list={['container', 'page-body', { 'page-body--toc': !!toc }]}>
    {toc && (
      <nav class="toc" aria-label={locale === 'ja' ? 'このページの内容' : 'On this page'}>
        <p class="toc__label">{locale === 'ja' ? 'このページの内容' : 'On this page'}</p>
        <ul>
          {toc.map((t) => (
            <li><a href={t.href}>{t.label}</a></li>
          ))}
        </ul>
      </nav>
    )}
    <div class="page-content">
      <slot />
    </div>
  </div>

  {cta !== false && <Cta locale={locale} title={cta?.title} text={cta?.text} />}
</Base>

<style>
  .page-head {
    padding-top: var(--space-5);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 12.5px;
    color: var(--ink-500);
  }
  .crumbs li + li::before {
    content: '›';
    margin-right: 6px;
  }
  .crumbs a {
    color: var(--ink-500);
  }
  .crumbs [aria-current] {
    color: var(--ink-700);
  }
  .page-title {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }
  .page-title__text {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .page-title h1 {
    font-family: var(--font-serif);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.45;
    color: var(--ink-900);
  }
  .lead {
    max-width: 560px;
  }
  .page-title__image {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: var(--radius-md);
  }
  .page-body {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }
  .toc {
    border-top: var(--border-rule) solid var(--line-strong);
    padding-top: 4px;
  }
  .toc__label {
    padding: 10px 0 4px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--ink-500);
  }
  .toc a {
    display: block;
    padding: 10px 0;
    border-bottom: var(--border-hair) solid var(--line-100);
    font-size: 14px;
    font-weight: 500;
  }
  .page-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    min-width: 0;
  }

  @media (min-width: 768px) {
    .page-title--with-image {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
    .page-title h1 {
      font-size: 40px;
      letter-spacing: 0.12em;
      line-height: 1.4;
    }
    .page-title__image {
      height: 300px;
    }
    .page-body {
      margin-top: var(--space-7);
    }
    .page-content {
      gap: var(--space-8);
    }
  }
  @media (min-width: 1024px) {
    .page-body--toc {
      grid-template-columns: 240px 1fr;
      gap: var(--space-7);
      align-items: start;
    }
    .toc {
      position: sticky;
      top: var(--space-5);
    }
  }
</style>
